# =============================================================================
# Docker Build Ignore — Backend
# Files/dirs listed here are excluded from the Docker build context.
# =============================================================================

# Environment files — secrets must NEVER be in the image
.env
.env.*
!.env.example

# Python caches and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git history (not needed in the image)
.git/
.gitignore

# Migration cache (keep .py files but exclude pycache)
migrations/__pycache__/
migrations/versions/__pycache__/