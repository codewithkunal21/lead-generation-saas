# =============================================================================
# Backend Environment Configuration — LeadPulse SaaS
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# --- General ---
PROJECT_NAME="LeadPulse SaaS Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"   # development | production | testing

# --- Security ---
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY="change-me-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=11520   # 8 days
ALGORITHM="HS256"

# =============================================================================
# DATABASE
# Option A (Recommended for production): Set DATABASE_URL directly.
#   Render, Railway, Fly.io all provide a DATABASE_URL.
#   Must use postgresql+asyncpg:// scheme (or postgres:// — auto-converted).
# Option B (Local Docker Compose): Set individual POSTGRES_* vars.
#   The URL is assembled automatically from these.
# =============================================================================

# Option A — set this for production (overrides Option B vars):
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# Option B — used in local Docker Compose (docker-compose.yml sets POSTGRES_SERVER=db):
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE-ME-strong-local-password"
POSTGRES_DB="saas_db"
POSTGRES_PORT=5432

# =============================================================================
# REDIS
# Option A (Recommended for production): Set REDIS_URL directly.
# Option B (Local Docker Compose): Set REDIS_HOST=redis (Docker service name).
# =============================================================================

# Option A — set this for production:
# REDIS_URL="redis://default:password@host:6379/0"

# Option B — local Docker Compose:
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# CELERY
# Normally inherited from REDIS_URL / REDIS_HOST above.
# Override only if using a different broker or backend.
# =============================================================================
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# =============================================================================
# CORS — Allowed Frontend Origins
# Comma-separated or JSON array. Add your actual Vercel frontend URL here.
# localhost / 127.0.0.1 origins are always allowed via regex (dev only).
# To change the allowed origin later, only update this env var — no code change needed.
# =============================================================================
BACKEND_CORS_ORIGINS="https://lead-generation-saas-ixyh.vercel.app"

# =============================================================================
# Initial Superuser Account
# Created idempotently on every container startup.
# Use a strong password in production.
# =============================================================================
FIRST_SUPERUSER_EMAIL="admin@example.com"
FIRST_SUPERUSER_PASSWORD="change-this-strong-password"
