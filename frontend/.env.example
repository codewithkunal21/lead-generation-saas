# =============================================================================
# Frontend Environment Variables — LeadPulse SaaS
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# ---------------------------------------------------------------------------
# VITE_API_BASE_URL — Backend API base URL (WITHOUT trailing slash)
#
# LOCAL DEVELOPMENT:
#   VITE_API_BASE_URL=http://localhost:8000
#
# PRODUCTION (set in Vercel project settings → Environment Variables):
#   VITE_API_BASE_URL=https://your-backend-service.onrender.com
#
# The frontend will call: ${VITE_API_BASE_URL}/api/v1/...
# Example: https://your-backend-service.onrender.com/api/v1/auth/login
#
# IMPORTANT: This variable is baked into the JavaScript bundle at BUILD TIME
# by Vite. Changing it requires a new build/deployment. Set it in Vercel
# Environment Variables and redeploy — do NOT put it in this file for production.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://lead-generation-saas-six.vercel.app
