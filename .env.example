# FastAPI general settings
PROJECT_NAME="SaaS Backend Application"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # development, production, testing

# Security
# Generate a secret key with: openssl rand -hex 32
SECRET_KEY="change-me-in-production-use-a-secure-32-byte-hex-string"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days (adjust for production)
ALGORITHM="HS256"

# Database Configuration
POSTGRES_SERVER="db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="saas_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@db:5432/saas_db"

# Redis Configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://redis:6379/0"

# Celery Configuration
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# CORS configurations (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:5173"

# pgAdmin (only needed for local development setup)
PGADMIN_DEFAULT_EMAIL="admin@saas.com"
PGADMIN_DEFAULT_PASSWORD="admin_secure_password"

# Initial Superuser Account Creation
FIRST_SUPERUSER_EMAIL="admin@example.com"
FIRST_SUPERUSER_PASSWORD="admin_super_secure_password"
